<!-- ドロワー -->
<ul class="menu menu-bordered w-80 min-h-full bg-base-100 text-base-content">

  <% if user_signed_in? %>
    <li>
      <summary><%= current_user.name %>さん、ようこそ！</summary>
      <details open>
        <summary><%= t('drawer.summary.mini_memory') %></summary>
        <ul>
          <li><%= link_to t('drawer.list.create_memory'), new_memory_path %></li>
          <li><%= link_to t('drawer.list.memory_index'), memories_path %></li>
          <li><%= link_to t('drawer.list.enjoy'), memory_game_path %></li>
        </ul>
      </details>
    </li>

    <li>
      <details>
        <summary><%= t('drawer.summary.family_mini_memory') %></summary>
        <ul>
          <li><%= link_to t('drawer.list.family_memory_index'), family_memories_path %></li>
        </ul>
      </details>
    </li>
  <% end %>

  <li>
    <details>
        <summary><%= t('drawer.summary.everyone_mini_memory') %></summary>
      <ul>
        <li><%= link_to t('drawer.list.board'), public_memories_path %></li>
      </ul>
    </details>
  </li>

  <li>
    <details>
      <summary><%= t('drawer.summary.account') %></summary>
      <% if user_signed_in? %>
        <ul>
          <li><%= link_to t('drawer.list.mypage'), mypage_path %></li>
          <li><%= link_to t('drawer.list.logout'), destroy_user_session_path, data: { turbo_method: :delete } %></li>
        </ul>
      <% else %>
        <ul>
          <li><%= link_to t('drawer.list.user_create'), new_user_registration_path %></li>
          <li><%= link_to t('drawer.list.login'), new_user_session_path %></li>
        </ul>
      <% end %>
    </details>
  </li>

  <li>
    <details>
      <summary><%= t('drawer.summary.others') %></summary>
      <ul>
        <li><%= link_to t('drawer.list.terms_of_service'), terms_path %></li>
        <li><%= link_to t('drawer.list.privacy_policy'), privacy_path %></li>
        <li><%= link_to t('drawer.list.contact'), contact_path %></li>
      </ul>
    </details>
  </li>

  <% if user_signed_in? && current_user.admin? %>
    <li>
      <%= link_to t('drawer.list.admin_panel'), rails_admin_path, target: "_blank", rel: "noopener" %>
    </li>
  <% end %>

  <li class="mt-auto text-center text-xs opacity-50 py-4">
    © 2026 minimemory
  </li>
</ul>
