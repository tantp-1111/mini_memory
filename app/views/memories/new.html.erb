<div class="min-h-screen bg-base-200 flex justify-center py-6 px-4">
  <!-- 背景装飾 -->
  <div class="fixed inset-0 overflow-hidden pointer-events-none">
    <div class="absolute -top-24 -right-24 w-96 h-96 rounded-full opacity-10 bg-primary blur-3xl"></div>
    <div class="absolute -bottom-24 -left-24 w-96 h-96 rounded-full opacity-10 bg-secondary blur-3xl"></div>
  </div>

  <div class="relative w-full max-w-2xl">

    <!-- ヘッダーセクション -->
    <div class="flex items-center gap-3 mb-4">
      <div class="inline-flex items-center justify-center w-10 h-10 rounded-xl bg-primary/10 shrink-0">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
            d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
        </svg>
      </div>
      <div>
        <h1 class="text-xl font-bold tracking-tight leading-tight"><%= t('.title') %></h1>
        <p class="text-base-content/50 text-xs"><%= t('.subtitle') %></p>
      </div>
    </div>

    <!-- メインカード -->
    <div class="card bg-base-100 shadow-2xl border border-base-200">
      <div class="card-body p-6 gap-4">
        <%= form_with model: @memory do |f| %>
          <%# バリデーション失敗時に turbo_stream で中身だけ差し替えるため id 付きコンテナで囲む %>
          <div id="error_explanation_container">
            <%= render 'shared/error_messages', object: f.object %>
          </div>

          <!-- タイトル -->
          <div class="form-control gap-1">
            <%= f.label :title, class: "label py-0" do %>
              <span class="label-text font-semibold text-xs tracking-wide uppercase text-base-content/60"><%= t('helpers.label.title') %></span>
            <% end %>
            <%= f.text_field :title,
                  placeholder: t('helpers.placeholder.title'),
                  class: "input input-bordered input-sm bg-base-200/50 focus:bg-base-100 focus:input-primary transition-all duration-200 w-full" %>
          </div>

          <!-- 説明 -->
          <div class="form-control gap-1">
            <%= f.label :description, class: "label py-0" do %>
              <span class="label-text font-semibold text-xs tracking-wide uppercase text-base-content/60"><%= t('helpers.label.description') %></span>
            <% end %>
            <%= f.text_area :description,
                  rows: 4,
                  placeholder: t('helpers.placeholder.description'),
                  class: "textarea textarea-bordered textarea-sm bg-base-200/50 focus:bg-base-100 focus:textarea-primary transition-all duration-200 w-full resize-none leading-relaxed" %>
          </div>

          <!-- 日付 & 公開範囲 - 横並び -->
          <div class="grid grid-cols-2 gap-4">

            <!-- 思い出の日付 -->
            <div class="form-control gap-1">
              <%= f.label :memory_date, class: "label py-0" do %>
                <span class="label-text font-semibold text-xs tracking-wide uppercase text-base-content/60"><%= t('helpers.label.memory_date') %></span>
              <% end %>
              <div class="relative">
                <span class="absolute left-3 top-1/2 -translate-y-1/2 text-base-content/40 pointer-events-none">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                </span>
                <%= f.date_field :memory_date,
                      value: f.object.memory_date || Date.today,
                      class: "input input-bordered input-sm bg-base-200/50 focus:bg-base-100 focus:input-primary transition-all duration-200 w-full pl-9" %>
              </div>
            </div>

            <!-- 公開範囲 -->
            <div class="form-control gap-1">
              <%= f.label :visibility, class: "label py-0" do %>
                <span class="label-text font-semibold text-xs tracking-wide uppercase text-base-content/60"><%= t('helpers.label.visibility') %></span>
              <% end %>
              <div class="relative">
                <span class="absolute left-3 top-1/2 -translate-y-1/2 text-base-content/40 pointer-events-none">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                  </svg>
                </span>
                <%= f.select :visibility,
                      Memory.visibility_options_for_select,
                      {},
                      class: "select select-bordered select-sm bg-base-200/50 focus:bg-base-100 focus:select-primary transition-all duration-200 w-full pl-9" %>
              </div>
            </div>
          </div>

          <%= render "child_selector" %>

          <%= render "tag_input", f: f %>

          <!-- 画像アップロード -->
          <div class="form-control gap-1">
            <span class="label-text font-semibold text-xs tracking-wide uppercase text-base-content/60"><%= t('helpers.label.image') %></span>

            <label for="memory_image"
              class="group flex flex-col gap-2 border-2 border-dashed border-base-300 hover:border-primary rounded-xl px-5 py-3 cursor-pointer transition-all duration-200 hover:bg-primary/5 bg-base-200/30">

              <%# アップロードアイコン & テキスト %>
              <div class="flex items-center gap-4">
                <div class="w-9 h-9 rounded-full bg-base-200 group-hover:bg-primary/10 flex items-center justify-center transition-colors duration-200 shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-base-content/40 group-hover:text-primary transition-colors duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                </div>
                <div>
                  <p class="text-sm font-medium text-base-content/70 group-hover:text-primary transition-colors duration-200"><%= t('helpers.placeholder.image.new') %></p>
                  <p class="text-xs text-base-content/40"><%= t('helpers.format.image') %></p>
                </div>
              </div>

              <%# ▼ プレビュー エリア（JS がファイル選択時に blob URL の img を挿入する） ▼ %>
              <div id="new-image" class="w-full rounded-lg overflow-hidden empty:hidden [&:not(:empty)]:h-32"></div>
              <%# ▼ ファイル名表示エリア ▼ %>
                <p id="file-name" class="hidden text-xs text-base-content/50 text-center truncate px-2"></p>

              <%= f.file_field :image,
                    id: "memory_image",
                    class: "hidden" %>
            </label>
          </div>

          <!-- 区切り線 & ボタン -->
          <div class="flex justify-end gap-2 pt-1 border-t border-base-200">
            <%= link_to t('defaults.cancel'), memories_path, class: "btn btn-ghost btn-sm" %>
            <%= f.submit nil, class: "btn btn-primary btn-sm px-6" %>
          </div>

        <% end %>
      </div>
    </div>
  </div>
</div>
