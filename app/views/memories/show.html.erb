<div class="max-w-6xl mx-auto px-4 py-10 lg:py-14">
  <div class="flex flex-col lg:flex-row gap-10 lg:gap-16 items-start">
    <!-- 背景装飾 -->
    <div class="fixed inset-0 overflow-hidden pointer-events-none">
      <div class="absolute -top-24 -right-24 w-96 h-96 rounded-full opacity-10 bg-primary blur-3xl"></div>
      <div class="absolute -bottom-24 -left-24 w-96 h-96 rounded-full opacity-10 bg-secondary blur-3xl"></div>
    </div>

    <%# ━━━━ 左カラム：画像 ━━━━ %>
    <div class="w-full lg:w-2/5 lg:sticky lg:top-20">

      <%# 画像カード %>
      <div class="card bg-base-100 shadow-xl overflow-hidden">
        <figure class="bg-base-200">
          <% if @memory.image.attached? %>
            <%= image_tag @memory.image,
                alt: @memory.title,
                class: "w-full object-contain max-h-[70vh]" %>
          <% else %>
            <div class="w-full h-64 flex items-center justify-center bg-base-200 text-base-content/50">
              <%= t('defaults.image_not_found') %>
            </div>
          <% end %>
        </figure>
      </div>

      <%# 日付バッジ %>
      <div class="mt-3 flex justify-end">
        <div class="badge badge-ghost gap-1 text-xs tracking-widest">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
          </svg>
          <%= l(@memory.memory_date, format: :short) %>
        </div>
      </div>

    </div>

    <%# ━━━━ 右カラム：コンテンツ ━━━━ %>
    <div class="w-full lg:w-3/5 flex flex-col gap-6">

      <%# タイトル %>
      <h1 class="text-3xl lg:text-4xl font-black leading-tight text-base-content">
        <%= @memory.title %>
      </h1>

      <%# 投稿者 %>
      <div class="flex items-center gap-3 pb-6 border-b border-base-200">
        <%= render "shared/user_avatar", user: @memory.user, size: :md %>
        <span class="text-sm text-base-content/60">
          <span class="font-semibold text-base-content/80"><%= @memory.user&.name || t('defaults.unknown_user') %></span>
          <%= t('defaults.users_minimemory') %>
        </span>
      </div>

      <%# こども（掲示板/public_memories#show では描画されない） %>
      <% if @memory.children.any? %>
        <div>
          <p class="text-xs font-bold tracking-widest text-base-content/40 mb-3">
            <%= t('memories.show.children_label') %>
          </p>
          <div class="flex flex-wrap gap-2">
            <% @memory.children.each do |child| %>
              <%= link_to child.name,
                    memories_path(q: { children_uuid_eq: child.uuid }),
                    class: "badge badge-primary badge-lg hover:badge-secondary transition-colors" %>
            <% end %>
          </div>
        </div>
      <% end %>

      <%# タグ（こども同様、掲示板/public_memories#show では描画されない） %>
      <% if @memory.tags.any? %>
        <div>
          <p class="text-xs font-bold tracking-widest text-base-content/40 mb-3">
            <%= t('memories.show.tags_label') %>
          </p>
          <div class="flex flex-wrap gap-x-3 gap-y-1 text-sm text-secondary">
            <% @memory.tags.each do |tag| %>
              <%= link_to "##{tag.name}",
                    memories_path(q: { tags_name_eq: tag.name }),
                    class: "hover:underline" %>
            <% end %>
          </div>
        </div>
      <% end %>

      <%# エピソード %>
      <div>
        <p class="text-xs font-bold tracking-widest text-base-content/40 mb-3">
          <%= t('defaults.episode') %>
        </p>
        <div class="card bg-base-100 shadow-md border-l-4 border-primary">
          <div class="card-body py-6 px-7">
            <div class="prose prose-sm max-w-none text-base-content/80 leading-loose">
              <%= simple_format(@memory.description) %>
            </div>
          </div>
        </div>
      </div>

      <%# 公開範囲 %>
      <div class="flex items-center gap-2 text-xs text-base-content/50">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
        </svg>
        <span><%= t('helpers.label.visibility') %></span>
        <span class="font-semibold text-base-content/70">
          <%= t("enums.memory.visibility.#{@memory.visibility}") %>
        </span>
      </div>

      <%# ボタン群 %>
      <div class="flex flex-col gap-3 pt-2">
        <% if policy(@memory).edit? %>
          <div class="flex gap-3">
            <%= link_to edit_memory_path(@memory),
                id: "button-edit-memory-#{@memory.id}",
                class: "btn btn-primary btn-sm gap-2" do %>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
              </svg>
              <%= t('helpers.submit.edit') %>
            <% end %>

            <%= link_to memory_path(@memory),
                id: "button-delete-memory-#{@memory.id}",
                data: { turbo_method: :delete, turbo_confirm: t("defaults.delete_confirm") },
                class: "btn btn-error btn-outline btn-sm gap-2" do %>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
              </svg>
              <%= t('helpers.submit.delete') %>
            <% end %>
          </div>
        <% end %>

        <%# Xシェアボタン（公開範囲が掲示板にて公開のみ表示） %>
        <% if @memory.published? %>
          <% share_target_url = public_memory_url(@memory.uuid) %>
          <%= link_to "https://twitter.com/intent/tweet?url=#{CGI.escape(share_target_url)}&text=#{CGI.escape(@memory.title)}&hashtags=#{CGI.escape('ミニメモリ')}",
              id: "button-share-x-#{@memory.id}",
              target: "_blank",
              rel: "noopener noreferrer",
              aria: { label: t('defaults.x_sharing') },
              title: t('defaults.x_sharing'),
              class: "btn btn-neutral btn-sm self-start gap-2" do %>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.748l7.73-8.835L1.254 2.25H8.08l4.253 5.622L18.244 2.25zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
            </svg>
            <span class="sr-only"><%= t('defaults.x_sharing') %></span>
          <% end %>
        <% end %>

        <%= link_to memories_path, class: "btn btn-ghost btn-sm self-start gap-2" do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
          </svg>
          <%= t('helpers.submit.return_to_list') %>
        <% end %>
      </div>

    </div><%# /右カラム %>
  </div>
</div>
