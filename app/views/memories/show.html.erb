<div class="max-w-3xl mx-auto px-4 py-6 space-y-6">

  <!-- 画像 -->
  <div class="w-full">
      <%= image_tag @memory.image, class: "aspect-square overflow-hidden bg-neutral" %>
  </div>

    <!-- タイトル -->
  <h1 class="text-3xl font-black leading-tight text-base-content">
    <%= @memory.title %>
  </h1>

  <div class="flex items-center gap-1 font-bold"> <%= @memory.user.name %> のミニメモリー</div>

  <!-- 日付 -->
    <div class="text-sm text-base-content/60">
      <%= l(@memory.memory_date) %>
    </div>

  <!-- 本文 -->
  <div class="space-y-4">
      <h3 class="font-bold text-base-content/40 tracking-widest text-sm">エピソード</h3>
      <div class="relative bg-red-50 p-6 rounded-3xl border-l-8 border-red-400">
        <p class="text-lg leading-relaxed text-base-content/80">
          <%= simple_format(@memory.description) %>
        </p>
      </div>
  </div>

  <!-- 公開範囲 -->
  <div class="text-sm text-gray-600">
    <span class="font-semibold">公開範囲：</span>
    <%= t("enums.memory.visibility.#{@memory.visibility}") %>
  </div>

  <!-- 操作ボタン（本人のみ） -->
  <% if current_user == @memory.user %>
    <div class="flex gap-2 pt-4">
      <%= link_to "編集",
          edit_memory_path(@memory),
          id: "button-edit-memory-#{@memory.id}",
          class: "btn btn-outline btn-primary" %>

      <%= link_to "削除",
          memory_path(@memory),
          id: "button-delete-memory-#{@memory.id}",
          data: { turbo_method: :delete, turbo_confirm: t("defaults.delete_confirm") },
          class: "btn btn-outline btn-error" %>
    </div>
  <% end %>

</div>
