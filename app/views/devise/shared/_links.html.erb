<%- if devise_mapping.confirmable? && controller_name != 'confirmations' %>
  <%= link_to "Didn't receive confirmation instructions?", new_confirmation_path(resource_name) %><br />
<% end %>

<%- if devise_mapping.lockable? && resource_class.unlock_strategy_enabled?(:email) && controller_name != 'unlocks' %>
  <%= link_to "Didn't receive unlock instructions?", new_unlock_path(resource_name) %><br />
<% end %>

<%- if devise_mapping.omniauthable? %>
  <%= button_to omniauth_authorize_path(resource_name, :line),
      method: :post,
      data: { turbo: false },
      form: { class: "w-full flex justify-center" } do %>

    <%= image_tag "line_login_btn.png",
      alt: "LINEでログイン",
      class: "w-40 h-auto transition-opacity duration-200 hover:opacity-80" %>
  <% end %>

  <%= button_to omniauth_authorize_path(resource_name, :google_oauth2),
      method: :post,
      data: { turbo: false },
      form: { class: "w-full flex justify-center mt-4" } do %>

    <%= image_tag "google_login_btn.png",
      alt: "Googleでログイン",
      class: "w-40 h-auto transition-opacity duration-200 hover:opacity-80" %>
  <% end %>
<% end %>

<%- if controller_name != 'sessions' %>
  <p class="text-center text-sm text-base-content/60 mt-4">
    すでにアカウントをお持ちですか？
    <%= link_to "ログイン", new_session_path(resource_name), class: "link link-primary font-semibold" %><br />
  </p>
<% end %>

<%- if devise_mapping.registerable? && controller_name != 'registrations' %>
  <p class="text-center text-sm text-base-content/60 mt-4">
    アカウントをお持ちでない方は
    <%= link_to "新規登録", new_registration_path(resource_name), class: "link link-primary font-semibold" %><br />
  </p>
<% end %>

<%#- if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
  <%# p class="text-center text-sm text-base-content/60 mt-4">
    パスワードをお忘れの方は
  <%#= link_to "パスワードをリセットする", new_password_path(resource_name), class: "link link-primary font-semibold" %>
<%# end %>
