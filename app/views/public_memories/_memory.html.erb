<div class="masonry-item">
<%= link_to public_memory_path(memory),
    id: "memory-id-#{memory.id}",
    class: "bg-base-100 block" do %>

    <div class="relative">
        <%= image_tag memory.display_image,
            alt: memory.title,
            class: "w-full object-cover rounded-lg block" %>

      <div class="absolute top-1 z-10">
                <div class="flex items-center gap-1 px-3 py-1">
        <div class="avatar placeholder">
            <div class="bg-neutral text-neutral-content rounded-full w-9 h-9 flex items-center justify-center">
              <span class="text-sm font-bold">
                <%= memory.user&.name&.slice(0, 1) || "?" %>
              </span>
            </div>
            </div>
        </div>
      </div>
    <!-- todo: ブックマーク実装後差し替え-->
      <div class="absolute top-3 right-3 z-10">
        <div class="flex items-center gap-1 px-3 py-1
                    rounded-full bg-black/50 text-white
                    backdrop-blur text-sm">
          ♡ <span class="font-semibold">12</span>
        </div>
      </div>

    </div>


<% end %>
</div>
