<!-- 固定背景: hero_top.png（ヒーロー範囲だけ可視。スクロールで下のコンテンツに隠れる） -->
<div class="fixed inset-0 -z-10 bg-cover bg-center pointer-events-none"
     style="background-image: url('<%= asset_path('hero_top.png') %>');">
</div>

<!-- ヒーローセクション（全画面、背景画像を透過させる） -->
<section class="relative min-h-screen flex flex-col items-center justify-center text-center px-4 overflow-hidden">
  <!-- 文字可読性のためのクリームオーバーレイ -->
  <div class="absolute inset-0 pointer-events-none"
       style="background: linear-gradient(180deg, rgba(255, 248, 241, 0.30) 0%, rgba(255, 248, 241, 0.45) 60%, rgba(255, 248, 241, 0.70) 100%);">
  </div>

  <!-- ヒーローコンテンツ -->
  <div class="relative max-w-2xl opacity-0 translate-y-8 transition-all duration-700 ease-out"
       data-controller="scroll-reveal">
    <span class="inline-block px-3 py-1 rounded-full uppercase mb-5 text-[10px] font-extrabold tracking-[0.05em]"
          style="background: #c9ec88; color: #4f6b16;">
      Mini Memory
    </span>

    <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold leading-snug mb-4"
        style="color: #1e1b17; text-shadow: 0 1px 3px rgba(255, 248, 241, 0.7);">
      小さな思い出が詰まったモノを<br>
      <span style="color: #d4af37;">写真とことば</span>で残そう
    </h1>

    <p class="text-sm sm:text-base md:text-lg leading-relaxed"
       style="color: #4d4635; text-shadow: 0 1px 2px rgba(255, 248, 241, 0.6);">
      どんぐり、葉っぱ、折り紙、らくがき。<br>
      片付ける前に、小さな思い出をここに残しませんか？
    </p>
  </div>

  <!-- SCROLL インジケータ -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2">
    <span class="text-[10px] tracking-[0.3em] font-extrabold uppercase" style="color: #8a7e72;">Scroll</span>
    <svg class="w-4 h-4 animate-bounce" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" style="color: #8a7e72;">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
    </svg>
  </div>
</section>

<!-- 使い方以降（不透明クリーム背景で固定画像を覆う） -->
<div class="relative" style="background-color: #fff8f1; color: #1e1b17;">
  <!-- 微細な紙風ドットパターン -->
  <div class="absolute inset-0 pointer-events-none"
       style="background-image: radial-gradient(circle at 1px 1px, rgba(212, 175, 55, 0.10) 1px, transparent 0); background-size: 24px 24px;">
  </div>

  <main class="relative max-w-2xl mx-auto px-4 sm:px-6 pt-16 sm:pt-20 pb-20">

    <!-- 使い方セクションヘッダ -->
    <div class="text-center mb-10 opacity-0 translate-y-8 transition-all duration-700 ease-out"
         data-controller="scroll-reveal">
      <span class="inline-block px-3 py-1 rounded-full uppercase mb-4 text-[10px] font-extrabold tracking-[0.05em]"
            style="background: #c9ec88; color: #4f6b16;">
        How To Use
      </span>
      <h2 class="text-xl sm:text-2xl font-extrabold leading-snug"
          style="color: #1e1b17;">
        <span style="color: #d4af37;">使い方</span>
      </h2>
    </div>

    <!-- 使い方タイムライン -->
    <div class="space-y-12 relative">

      <!-- Step 1: 写真を撮る -->
      <div class="flex gap-4 relative">
        <div class="relative flex-shrink-0">
          <!-- 縦の点線（次のステップに繋がる） -->
          <div class="absolute w-0.5"
               style="left: 19px; top: 40px; height: 100%; background: repeating-linear-gradient(to bottom, #d4af37 0, #d4af37 4px, transparent 4px, transparent 8px);">
          </div>
          <!-- 番号バッジ -->
          <div class="w-10 h-10 flex items-center justify-center rounded-full text-white font-bold shadow-lg relative z-10"
               style="background: #d4af37;">
            1
          </div>
        </div>

        <div class="flex-grow pb-4">
          <div class="rounded-xl border overflow-hidden shadow-sm p-4 transition-all duration-700 ease-out hover:shadow-md opacity-0 translate-y-8"
               data-controller="scroll-reveal"
               style="background: rgba(255, 255, 255, 0.7); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); border-color: #e5e0d5;">
            <div class="aspect-square rounded-lg overflow-hidden mb-4 border" style="border-color: rgba(229, 224, 213, 0.5);">
              <%= image_tag "how_to_use1.png",
                  alt: "写真を撮る",
                  class: "w-full h-full object-cover",
                  loading: "lazy" %>
            </div>
            <h3 class="text-lg font-bold mb-2" style="color: #735c00;">写真を撮る</h3>
            <p class="text-base leading-relaxed" style="color: #4d4635;">
              どんぐり、葉っぱ、折り紙、らくがき。<br>
              こどもがくれた小さな宝物たち。片付けにくい小さなモノを、まずは写真におさめましょう。
            </p>
          </div>
        </div>
      </div>

      <!-- Step 2: エピソードを残す -->
      <div class="flex gap-4 relative">
        <div class="relative flex-shrink-0">
          <div class="absolute w-0.5"
               style="left: 19px; top: 40px; height: 100%; background: repeating-linear-gradient(to bottom, #d4af37 0, #d4af37 4px, transparent 4px, transparent 8px);">
          </div>
          <div class="w-10 h-10 flex items-center justify-center rounded-full text-white font-bold shadow-lg relative z-10"
               style="background: #d4af37;">
            2
          </div>
        </div>

        <div class="flex-grow pb-4">
          <div class="rounded-xl border overflow-hidden shadow-sm p-4 transition-all duration-700 ease-out hover:shadow-md opacity-0 translate-y-8"
               data-controller="scroll-reveal"
               style="background: rgba(255, 255, 255, 0.7); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); border-color: #e5e0d5;">
            <div class="aspect-square rounded-lg overflow-hidden mb-4 border" style="border-color: rgba(229, 224, 213, 0.5);">
              <%= image_tag "how_to_use3.png",
                  alt: "エピソードを残す",
                  class: "w-full h-full object-cover",
                  loading: "lazy" %>
            </div>
            <h3 class="text-lg font-bold mb-2" style="color: #735c00;">エピソードを残す</h3>
            <p class="text-base leading-relaxed" style="color: #4d4635;">
              「誰の・いつ・どんな」を一緒に記録。<br>
              そのときの温かな気持ちも、写真の隣に残せます。
            </p>
          </div>
        </div>
      </div>

      <!-- Step 3: ものは手放せる -->
      <div class="flex gap-4 relative">
        <div class="relative flex-shrink-0">
          <div class="absolute w-0.5"
               style="left: 19px; top: 40px; height: 100%; background: repeating-linear-gradient(to bottom, #d4af37 0, #d4af37 4px, transparent 4px, transparent 8px);">
          </div>
          <div class="w-10 h-10 flex items-center justify-center rounded-full text-white font-bold shadow-lg relative z-10"
               style="background: #d4af37;">
            3
          </div>
        </div>

        <div class="flex-grow pb-4">
          <div class="rounded-xl border overflow-hidden shadow-sm p-4 transition-all duration-700 ease-out hover:shadow-md opacity-0 translate-y-8"
               data-controller="scroll-reveal"
               style="background: rgba(255, 255, 255, 0.7); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); border-color: #e5e0d5;">
            <div class="aspect-square rounded-lg overflow-hidden mb-4 border" style="border-color: rgba(229, 224, 213, 0.5);">
              <%= image_tag "how_to_use2.png",
                  alt: "ものは手放せる",
                  class: "w-full h-full object-cover",
                  loading: "lazy" %>
            </div>
            <h3 class="text-lg font-bold mb-2" style="color: #735c00;">ものは手放せる</h3>
            <p class="text-base leading-relaxed" style="color: #4d4635;">
              デジタルでしっかり残っているから、<br>
              現物は安心して整理できます。お部屋も心もスッキリ。
            </p>
          </div>
        </div>
      </div>

      <!-- Step 4: ゲームで振り返る（最終ステップなので縦線なし） -->
      <div class="flex gap-4 relative">
        <div class="relative flex-shrink-0">
          <div class="w-10 h-10 flex items-center justify-center rounded-full text-white font-bold shadow-lg relative z-10"
               style="background: #d4af37;">
            4
          </div>
        </div>

        <div class="flex-grow">
          <div class="rounded-xl border overflow-hidden shadow-sm p-4 transition-all duration-700 ease-out hover:shadow-md opacity-0 translate-y-8"
               data-controller="scroll-reveal"
               style="background: rgba(255, 255, 255, 0.7); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); border-color: #e5e0d5;">
            <div class="aspect-square rounded-lg overflow-hidden mb-4 border" style="border-color: rgba(229, 224, 213, 0.5);">
              <%= image_tag "how_to_use4.png",
                  alt: "ゲームで振り返る",
                  class: "w-full h-full object-cover",
                  loading: "lazy" %>
            </div>
            <h3 class="text-lg font-bold mb-2" style="color: #735c00;">ゲームで振り返る</h3>
            <p class="text-base leading-relaxed" style="color: #4d4635;">
              残した思い出は、お子さんと一緒にゲームで振り返りましょう。<br>
              「これ覚えてる？」と笑い合える、家族の時間に。
            </p>
          </div>
        </div>
      </div>

    </div>

    <!-- こんな方におすすめ セクション -->
    <section class="mt-16 sm:mt-20">
      <!-- セクションヘッダ -->
      <div class="text-center mb-10 opacity-0 translate-y-8 transition-all duration-700 ease-out"
           data-controller="scroll-reveal">
        <span class="inline-block px-3 py-1 rounded-full uppercase mb-4 text-[10px] font-extrabold tracking-[0.05em]"
              style="background: #c9ec88; color: #4f6b16;">
          For You
        </span>
        <h2 class="text-xl sm:text-2xl font-extrabold leading-snug"
            style="color: #1e1b17;">
          こんな方に<span style="color: #d4af37;">おすすめ</span>
        </h2>
      </div>

      <!-- ペルソナ4カード -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">

        <!-- ペルソナ① 子育て中の方 -->
        <div class="rounded-xl border shadow-sm p-5 transition-all duration-700 ease-out hover:shadow-md hover:-translate-y-1 opacity-0 translate-y-8"
             data-controller="scroll-reveal"
             data-scroll-reveal-delay-value="0"
             style="background: rgba(255, 255, 255, 0.7); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); border-color: #e5e0d5;">
          <div class="w-12 h-12 rounded-xl flex items-center justify-center mb-4"
               style="background: rgba(212, 175, 55, 0.18);">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6" style="color: #d4af37;">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
            </svg>
          </div>
          <h3 class="text-base font-bold mb-2" style="color: #735c00;">子育て中の方</h3>
          <p class="text-sm leading-relaxed" style="color: #4d4635;">
            こどもが作った折り紙や、外で拾ったどんぐり。ぐんぐん増える宝物に、嬉しい悲鳴をあげている方へ。
          </p>
        </div>

        <!-- ペルソナ② 片付けたいけど捨てられない方 -->
        <div class="rounded-xl border shadow-sm p-5 transition-all duration-700 ease-out hover:shadow-md hover:-translate-y-1 opacity-0 translate-y-8"
             data-controller="scroll-reveal"
             data-scroll-reveal-delay-value="150"
             style="background: rgba(255, 255, 255, 0.7); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); border-color: #e5e0d5;">
          <div class="w-12 h-12 rounded-xl flex items-center justify-center mb-4"
               style="background: rgba(134, 166, 75, 0.20);">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6" style="color: #86a64b;">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 7.5l-9-5.25L3 7.5m18 0l-9 5.25m9-5.25v9l-9 5.25M3 7.5l9 5.25M3 7.5v9l9 5.25m0-9v9" />
            </svg>
          </div>
          <h3 class="text-base font-bold mb-2" style="color: #735c00;">片付けたいけど<br class="hidden sm:inline">捨てられない方</h3>
          <p class="text-sm leading-relaxed" style="color: #4d4635;">
            「思い出があって捨てられない」を抱えがちな方。罪悪感なく手放すための「残し方」をお届けします。
          </p>
        </div>

        <!-- ペルソナ③ あとから振り返りたい方 -->
        <div class="rounded-xl border shadow-sm p-5 transition-all duration-700 ease-out hover:shadow-md hover:-translate-y-1 opacity-0 translate-y-8"
             data-controller="scroll-reveal"
             data-scroll-reveal-delay-value="300"
             style="background: rgba(255, 255, 255, 0.7); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); border-color: #e5e0d5;">
          <div class="w-12 h-12 rounded-xl flex items-center justify-center mb-4"
               style="background: rgba(138, 126, 114, 0.20);">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6" style="color: #8a7e72;">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
            </svg>
          </div>
          <h3 class="text-base font-bold mb-2" style="color: #735c00;">あとから<br class="hidden sm:inline">振り返りたい方</h3>
          <p class="text-sm leading-relaxed" style="color: #4d4635;">
            子どもが大きくなったときに「あの頃ね」と一緒に見返したい。そんな未来の楽しみを今のうちに残しておきたい方へ。
          </p>
        </div>

        <!-- ペルソナ④ 思い出を分かち合いたい方 -->
        <div class="rounded-xl border shadow-sm p-5 transition-all duration-700 ease-out hover:shadow-md hover:-translate-y-1 opacity-0 translate-y-8"
             data-controller="scroll-reveal"
             data-scroll-reveal-delay-value="450"
             style="background: rgba(255, 255, 255, 0.7); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); border-color: #e5e0d5;">
          <div class="w-12 h-12 rounded-xl flex items-center justify-center mb-4"
               style="background: rgba(201, 140, 107, 0.20);">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6" style="color: #c98c6b;">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z" />
            </svg>
          </div>
          <h3 class="text-base font-bold mb-2" style="color: #735c00;">思い出を<br class="hidden sm:inline">分かち合いたい方</h3>
          <p class="text-sm leading-relaxed" style="color: #4d4635;">
            おじいちゃん・おばあちゃんに見せたい、同じ気持ちの誰かと繋がりたい。みんなの思い出として共有することもできます。
          </p>
        </div>

      </div>
    </section>

    <!-- CTA セクション -->
    <div class="mt-16 sm:mt-20 text-center opacity-0 translate-y-8 transition-all duration-700 ease-out"
         data-controller="scroll-reveal">
      <%= link_to "さっそくはじめる",
          new_user_registration_path,
          class: "inline-block py-4 px-12 rounded-full text-white text-lg font-bold transition-all duration-300 hover:opacity-90 active:scale-95",
          style: "background: #d4af37; box-shadow: 0 10px 25px -5px rgba(212, 175, 55, 0.3);" %>

      <p class="mt-6 italic text-sm" style="color: #8a7e72;">
        まずは今日、見つけたものから。
      </p>

      <div class="mt-12 pt-8 border-t space-y-3" style="border-color: #e5e0d5;">
        <p class="text-sm" style="color: #8a7e72;">
          登録なしでみんなの思い出が見られます　→　<%= link_to "みんなの思い出を見る",
              public_memories_path,
              class: "underline underline-offset-2 font-semibold",
              style: "color: #735c00;" %>
        </p>
        <p class="text-sm" style="color: #8a7e72;">
          アカウントをお持ちの方は<%= link_to "ログイン",
              new_user_session_path,
              class: "underline underline-offset-2 font-semibold ml-1",
              style: "color: #735c00;" %>
        </p>
      </div>
    </div>

  </main>
</div>
